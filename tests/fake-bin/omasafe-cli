#!/usr/bin/env python3
"""Deterministic fake OmaSafe CLI used only by disposable transport tests."""

import json
import os
import sys
import time


args = sys.argv[1:]
log_path = os.environ.get("FAKE_ARGV_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(args, ensure_ascii=True) + "\n")

scenario = os.environ.get("FAKE_OMASAFE_SCENARIO", "default")

if args in ([], ["--version"], ["-V"]):
    print("omasafe-cli 0.2.5" if scenario == "v025" else "omasafe-cli 0.2.1")
    raise SystemExit(0)

if scenario == "stderr-error":
    print("omasafe: refused by fixture", file=sys.stderr)
    raise SystemExit(1)
if scenario == "usage":
    print("usage: omasafe-cli ...", file=sys.stderr)
    raise SystemExit(2)
if scenario == "interrupt":
    raise SystemExit(130)
if scenario == "timeout":
    time.sleep(2)
    raise SystemExit(0)
if scenario == "oversized":
    size = 5 * 1024 * 1024 if args and args[0] == "scan" else 2 * 1024 * 1024
    sys.stdout.write("X" * size)
    raise SystemExit(0)
if scenario == "text-success":
    print("Trusted identity recorded in disposable state")
    raise SystemExit(0)
if scenario == "malformed":
    print('{"schema":')
    raise SystemExit(0)


