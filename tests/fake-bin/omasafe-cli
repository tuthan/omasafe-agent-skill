payload = report()
if scenario == "candidate":
    payload["tool_version"] = "0.2.2"
print(json.dumps(payload))
if scenario == "actionable-scan" and args and args[0] == "scan":
    raise SystemExit(3)
if scenario in {"threshold", "exit4-no-gate"} and args and args[0] in {"plugins", "scan-plugin"}:
    raise SystemExit(4)
