    elif command == "scan-plugin":
        if scenario in {"candidate", "local-review", "malformed-omissions", "v024-review", "v025"}:
            result = {
                "target": {
                    "source": "resolved-git-request",
                    "url": "https://github.com/example/plugin.git",
                    "revision": "a" * 40,
