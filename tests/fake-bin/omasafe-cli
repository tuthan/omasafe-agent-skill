def enforcement():
    outcome = "mystery" if scenario == "unknown-enum" else "allow"
    decision = {
        "schema": "omasafe.enforcement.v2" if scenario == "v025" else "omasafe.enforcement.v1",
        "plugin_id": "io.example.fixture",
        "operation": "enable",
        "evaluation_state": "evaluated",
        "outcome": outcome,
        "authorization_basis": "policy",
        "reason_codes": [],
        "blocking_rule_ids": [],
    }
    if scenario == "v025":
        decision.update({
            "blockers": [],
            "opaque_code_items": [],
            "executable_review_policy_version": "omasafe.executable-review-policy.v1",
        })
    return decision


def report():
    command = args[0] if args else ""
    result = {"plugins": [{"id": "io.example.fixture", "path": "fixture"}]}
    if command == "plugins" and len(args) > 1:
        subcommand = args[1]
        if subcommand in ("analyze",) or subcommand == "status":
            result["plugin_id"] = "io.example.fixture"
        if subcommand == "enforcement-status":
            result = {"plugin_id": "io.example.fixture", "decision": enforcement()}
            if scenario == "v025":
                result["enforcement_policy"] = {"schema": "omasafe.enforcement-policy.v2"}
        elif subcommand == "enable":
            result = {"plugin_id": "io.example.fixture", "enabled": True, "decision": enforcement()}
        elif subcommand == "analyze":
            result = {"plugin_id": "io.example.fixture", "analysis": analysis()}
        elif subcommand == "override" and len(args) > 2 and args[2] == "list":
            result = {"overrides": []}
        elif subcommand == "executable-review" and len(args) > 2 and args[2] == "list":
            result = {"plugin_id": "io.example.fixture", "reviews": [{
                "binding": {
                    "schema": "omasafe.executable-review.v1",
