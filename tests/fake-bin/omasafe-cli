if args and args[0] == "provenance":
    print(json.dumps({
        "schema": "omasafe.provenance.v1",
        "tool_version": "0.2.1",
        "supported_runtime": {"omarchy": "4.0.0-1", "quickshell": "0.3.0"},
        "coverage_limitations": ["fixture"],
